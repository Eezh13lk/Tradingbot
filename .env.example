# Binance API credentials (SPOT trading only — disable withdrawals on the key)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# true = paper / public market data only (no live orders)
DRY_RUN=true

# Use Binance testnet when DRY_RUN=false for safer live testing (optional)
# BINANCE_TESTNET=false

# Symbol and sizing
SYMBOL=BTCUSDT
MAX_POSITION_USD=50
MAX_DAILY_LOSS_USD=2
STOP_LOSS_PCT=0.01

# Strategy
LOOKBACK_CANDLES=20
ENTRY_ZSCORE=1.5
TAKE_PROFIT_PCT=0.008
COOLDOWN_SECONDS=120
FEE_RATE=0.001

# Soft metrics target only — NOT a profit guarantee
SOFT_DAILY_TARGET_USD=1

# Loop
POLL_INTERVAL_SECONDS=15
